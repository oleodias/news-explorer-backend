# Só no servidor. Copie para .env e troque os valores; o .env não vai para o Git.
# Sem o .env (desenvolvimento), o app usa os valores de utils/config.js.
NODE_ENV=production
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/news-explorer
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_64_caracteres_hexadecimais
